# =====================================================================
# EvoCare Multi-Tier AI Provider Configuration
# =====================================================================
# Free-Tier Resilient Setup:
# Tier 1: Google Gemini Flash (via GEMINI_API_KEY)
# Tier 2: Groq Primary (openai/gpt-oss-120b) -> Groq Fallback (openai/gpt-oss-20b)
# Tier 3: Deterministic Clinical Rule Engine (Automatic Offline Fallback)

# Google Gemini API Key (Get free at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq Cloud API Key (Get free at https://console.groq.com/)
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Master toggle for LLM features (set to false to force offline deterministic mode)
LLM_ENABLED=true

# Security & JWT settings
JWT_SECRET_KEY=evocare-dev-jwt-secret-key-32bytes-long-2026!!
AUTH_ENABLED=true
DEMO_MODE=true

# ---------------------------------------------------------------------
# MedGemma 1.5 (google/medgemma-1.5-4b-it) — 3D Human Anatomy explainer
# Serve via any OpenAI-compatible endpoint, then point EvoCare at it:
#   vLLM   : vllm serve google/medgemma-1.5-4b-it --port 8001  -> http://localhost:8001/v1
#   Ollama : ollama pull hf.co/unsloth/medgemma-1.5-4b-it-GGUF -> http://localhost:11434/v1
#   HF     : https://router.huggingface.co/v1  (MEDGEMMA_API_KEY = your HF token; model is gated, accept licence first)
# Leave MEDGEMMA_BASE_URL empty to fall back to Gemini -> Groq -> offline engine.
# ---------------------------------------------------------------------
MEDGEMMA_BASE_URL=
MEDGEMMA_API_KEY=
MEDGEMMA_MODEL=google/medgemma-1.5-4b-it
MEDGEMMA_TIMEOUT_SECONDS=60
MEDGEMMA_PRIMARY_FOR_REASONING=false
